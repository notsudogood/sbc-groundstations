#!/bin/sh
# Mount the CONFIG partition at /config and seed it with the board's defaults.
#
# /config is where every user-editable config file lives. The partition is
# FAT32 with a Microsoft-basic-data GPT type (see the config block in the
# initramfs-less /init) precisely so it can be edited from a Windows box with
# the card in a reader -- which is also why the files here are plain,
# comment-heavy toml rather than anything generated.
#
# Runs before everything else (S00) because S39wifi reads /config/wifi.toml,
# and S96maburgs and S97maburplay read /etc/maburgs.toml and
# /etc/maburplay.toml, both of which are symlinks into /config.
#
# This deliberately runs after pivot_root rather than inside /init: / is the
# overlay by now, so if the mount fails -- card yanked, FAT trashed by an
# unclean eject on the PC -- /config stays a writable directory on the overlay,
# the seeding below still fills it, and the box boots with working configs
# instead of two dangling symlinks and no ground station.

CONFIG_DIR=${CONFIG_DIR:-/config}
DEFAULTS_DIR=${DEFAULTS_DIR:-/usr/share/config-defaults}
# mabur's two files are refreshed once per new image (refresh_mabur). The
# stamps are the image defaults each was last refreshed from; touch
# $CONFIG_DIR/keep-config to never refresh.
REFRESH_FILES="maburgs.toml maburplay.toml"
STAMP_DIR=$CONFIG_DIR/.image-defaults
OLD_DIR=$CONFIG_DIR/old
MENU_FILE=${MENU_FILE:-/etc/maburgs.menu}

is_refreshed() { case " $REFRESH_FILES " in *" $1 "*) return 0 ;; esac; return 1; }

same() {
	[ -f "$1" ] && [ -f "$2" ] || return 1
	if command -v cmp >/dev/null 2>&1; then cmp -s "$1" "$2"
	else [ "$(md5sum <"$1")" = "$(md5sum <"$2")" ]; fi
}

seed_defaults() {
	[ -d "$DEFAULTS_DIR" ] || return 0
	for f in "$DEFAULTS_DIR"/*; do
		[ -f "$f" ] || continue
		name=$(basename "$f")
		[ -e "$CONFIG_DIR/$name" ] && continue
		cp "$f" "$CONFIG_DIR/"
		if is_refreshed "$name"; then mkdir -p "$STAMP_DIR" && cp "$f" "$STAMP_DIR/$name"; fi
	done
	sync
}

# New image, new defaults: sysupgrade rewrites the root filesystem only, so
# a maburgs.toml / maburplay.toml saved under an older image hid every
# default the new image changed -- and a key the old file lacks takes the
# code default, not the shipped one. Once per change of the shipped
# default: the file is replaced by the new default; an edited one is first
# copied to $OLD_DIR/<name>.oldN. With maburgs.toml goes the on-screen
# menu's saved choice ($MENU_FILE: hop, channel, bandwidth), which
# overrides it. Edits made under THIS image stay (the stamp matches), and
# so does everything with $CONFIG_DIR/keep-config there. wifi.toml is never
# touched.
refresh_mabur() {
	for name in $REFRESH_FILES; do
		def=$DEFAULTS_DIR/$name cur=$CONFIG_DIR/$name stamp=$STAMP_DIR/$name
		[ -f "$def" ] && [ -f "$cur" ] || continue
		mkdir -p "$STAMP_DIR"
		if same "$def" "$cur"; then
			same "$def" "$stamp" || cp "$def" "$stamp"
			continue
		fi
		same "$def" "$stamp" && continue
		if [ -e "$CONFIG_DIR/keep-config" ]; then
			echo "config: new image, $cur kept as is (keep-config is there)"
			continue
		fi
		what="reset to the new default"
		if ! same "$cur" "$stamp"; then
			n=1
			while [ -e "$OLD_DIR/$name.old$n" ]; do n=$((n + 1)); done
			mkdir -p "$OLD_DIR" && cp "$cur" "$OLD_DIR/$name.old$n" || {
				echo "config: cannot back up $cur, kept as is"
				continue
			}
			what="$what; yours is $OLD_DIR/$name.old$n"
		fi
		cp "$def" "$cur" && cp "$def" "$stamp"
		if [ "$name" = maburgs.toml ] && [ -f "$MENU_FILE" ]; then
			mkdir -p "$OLD_DIR" && mv "$MENU_FILE" "$OLD_DIR/maburgs.menu.old" &&
				what="$what; the menu's saved choice was cleared"
		fi
		echo "config: new image -- $cur $what"
		echo "$(date) $cur $what" >>"$CONFIG_DIR/config-reset.log"
	done
	sync
}

case "$1" in
	start)
		mkdir -p "$CONFIG_DIR"
		# head -1: booting from eMMC with an SD card in the slot can turn up
		# two CONFIG partitions. The one on the boot disk is listed first.
		dev=$(blkid | grep 'LABEL="CONFIG"' | cut -d : -f 1 | head -1)
		if [ -z "$dev" ]; then
			echo "config: no CONFIG partition found, using $CONFIG_DIR on the overlay"
		# umask=0000 because vfat has no permission bits of its own: without it
		# every file lands 0755/root and nothing but root can edit them on-box.
		elif ! mount -t vfat -o umask=0000 "$dev" "$CONFIG_DIR"; then
			echo "config: mounting $dev on $CONFIG_DIR failed, using the overlay instead"
		fi
		seed_defaults
		refresh_mabur
		;;
	refresh)
		# The same seed + refresh on a mounted /config, without the mount.
		seed_defaults
		refresh_mabur
		;;
	stop)
		sync
		mountpoint -q "$CONFIG_DIR" && umount "$CONFIG_DIR"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "usage: $0 {start|stop|restart|refresh}"
		exit 1
		;;
esac
